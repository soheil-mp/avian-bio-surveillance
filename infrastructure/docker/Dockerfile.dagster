# =============================================================================
# Dockerfile.dagster — Dagster webserver and daemon image
# =============================================================================
# Provides the non-root runtime shared by two services in the stack:
#
#   * ab-dagster-webserver — Dagster UI and GraphQL API
#   * ab-dagster-daemon    — scheduler, sensors, run coordinator
#
# User code (jobs, schedules, sensors) is intentionally not bundled into
# this image. The repository's Dagster `defs` are loaded over gRPC from
# the `ab-ingestion` and `ab-model` containers, so this image only needs
# the Dagster framework, the GraphQL surface, and the Postgres storage
# adapter.
#
# `workspace.yaml` is generated by the Compose `command` at container
# start from variables defined in `config/runtime.env`, so it is not baked
# into the image. `dagster.yaml` is supplied via a bind mount from
# docker-compose.
# =============================================================================

FROM python:3.12-slim-bookworm

# Cache-bust token. Bump to force the dependency-install layer to rebuild
# without invalidating earlier layers.
ARG DAGSTER_IMAGE_CACHE_BUST=20260509

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DAGSTER_HOME=/opt/dagster_home

# Dagster packages pinned to the same major versions declared in
# pyproject.toml so the image and the orchestration dependency group
# cannot drift.
RUN test -n "$DAGSTER_IMAGE_CACHE_BUST" \
    && pip install --no-cache-dir \
        "dagster==1.9.*" \
        "dagster-webserver==1.9.*" \
        "dagster-postgres==0.25.*" \
        "dagster-graphql==1.9.*"

# Startup helper scripts invoked from the Compose `command` blocks of the
# webserver and daemon services:
#
#   dagster_migrate_instance.py        — apply instance-storage migrations
#   dagster_reconcile_sensor_state.py  — re-arm sensors after restart
#   dagster_reconcile_run_state.py     — fail orphan STARTED/STARTING runs
#   dagster_wait_for_code_servers.py   — block until gRPC code-servers are up
COPY scripts/ops/dagster_migrate_instance.py /usr/local/bin/dagster_migrate_instance.py
COPY scripts/ops/dagster_reconcile_sensor_state.py /usr/local/bin/dagster_reconcile_sensor_state.py
COPY scripts/ops/dagster_reconcile_run_state.py /usr/local/bin/dagster_reconcile_run_state.py
COPY scripts/ops/dagster_wait_for_code_servers.py /usr/local/bin/dagster_wait_for_code_servers.py

# Non-root runtime user. The DAGSTER_HOME directory is created here and
# chowned so the bind-mounted host directory inherits the right ownership
# on first boot.
RUN groupadd --system --gid 1001 dagster \
    && useradd --system --uid 1001 --gid dagster --create-home dagsteruser \
    && mkdir -p ${DAGSTER_HOME} \
    && chmod 755 /usr/local/bin/dagster_migrate_instance.py \
    && chmod 755 /usr/local/bin/dagster_reconcile_sensor_state.py \
    && chmod 755 /usr/local/bin/dagster_reconcile_run_state.py \
    && chmod 755 /usr/local/bin/dagster_wait_for_code_servers.py \
    && chown -R dagsteruser:dagster ${DAGSTER_HOME}

USER dagsteruser
WORKDIR ${DAGSTER_HOME}

LABEL org.opencontainers.image.title="avian-biosurveillance-dagster"
LABEL org.opencontainers.image.description="Avian Biosurveillance — Dagster (webserver + daemon, non-root)"
LABEL org.opencontainers.image.authors="Soheil Mohammadpour <soheil.mpg@gmail.com>"
LABEL org.opencontainers.image.version="0.1.0"
LABEL org.opencontainers.image.source="https://github.com/soheil-mp/avian-biosurveillance"
