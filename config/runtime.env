# =============================================================================
# Runtime topology for the Avian Biosurveillance platform
# =============================================================================
# This file is the source of truth for non-secret service configuration:
# ports, bind addresses, internal service hostnames, and public URLs.
# Keep credentials and API keys in the ignored/encrypted `.env` file.

# Host bindings
AVIAN_BIND_HOST=127.0.0.1

# Container-local timezone used for service log timestamps.
AVIAN_TIMEZONE=Europe/Amsterdam

# TimescaleDB / PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_INTERNAL_HOST=timescaledb
POSTGRES_INTERNAL_PORT=5432
TSDB_PORT=15432

# MinIO
MINIO_INTERNAL_HOST=minio
MINIO_INTERNAL_API_PORT=9000
MINIO_INTERNAL_CONSOLE_PORT=9001
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_USE_SSL=false

# Dagster webserver, GraphQL API, and gRPC code-server
DAGSTER_WEBSERVER_HOST=0.0.0.0
DAGSTER_INTERNAL_HOST=dagster-webserver
DAGSTER_INTERNAL_PORT=3000
DAGSTER_PORT=13030
DAGSTER_CODE_SERVER_HOST=0.0.0.0
DAGSTER_CODE_SERVER_DOCKER_HOST=ingestion
DAGSTER_CODE_SERVER_LOCAL_HOST=127.0.0.1
DAGSTER_CODE_SERVER_PORT=4000
DAGSTER_LOCATION_NAME=pipelines
DAGSTER_MODEL_CODE_SERVER_DOCKER_HOST=model
DAGSTER_MODEL_CODE_SERVER_LOCAL_HOST=127.0.0.1
DAGSTER_MODEL_CODE_SERVER_PORT=4001
DAGSTER_MODEL_LOCATION_NAME=models
DAGSTER_GRAPHQL_URL=http://dagster-webserver:3000/graphql
NEXT_PUBLIC_DAGSTER_GRAPHQL_URL=http://localhost:13030/graphql
NEXT_PUBLIC_DAGSTER_UI_URL=http://localhost:13030

# Historical catchup startup controls
# BirdWeather has its own dedicated catchup sensor. The shared historical
# catchup autostarts on boot by default and walks one logical day per sensor
# tick from the configured start date toward yesterday. Prefer the CATCHUP_*
# variables below; the legacy BACKFILL_* aliases remain supported for
# compatibility.
CATCHUP_AUTOSTART=true
# CATCHUP_START_DATE=2024-01-01
# CATCHUP_END_DATE=
# CATCHUP_TARGET=database
# CATCHUP_SOURCES=knmi,ebird,earth_engine_grid

# Earth Engine grid ingestion throughput controls
# EARTH_ENGINE_HIGH_VOLUME=true
# EARTH_ENGINE_SECTION_WORKERS=4
# EARTH_ENGINE_GRID_CELL_WORKERS=2
# EARTH_ENGINE_GRID_DB_BATCH_SIZE=200
# EARTH_ENGINE_HTTP_POOL_SIZE=10

# Frontend
APP_INTERNAL_HOST=0.0.0.0
APP_INTERNAL_PORT=3000
APP_PORT=13000
INTERNAL_URL=http://localhost:3000

# External service endpoints
CDS_API_URL=https://cds.climate.copernicus.eu/api
