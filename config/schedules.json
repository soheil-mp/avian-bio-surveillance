{
    "_comment": "Per-deployment orchestration metadata for the Dagster layer. `enabled` controls the default on/off state of cron-backed entries and catchup sensors. `run_on_startup` controls the startup sensors. `execution_modes` declares how each deployment is triggered (`cron`, `startup`, `sensor`, `auto`, `manual`), and `depends_on` documents the intended upstream relationships even when the actual execution order is enforced by Dagster sensors or the asset graph. Species IDs are injected at runtime from target_species.json.",
    "deployments": [
        {
            "_comment": "=== BIRDWEATHER (heaviest: bulk API + audio downloads) ===",
            "name": "birdweather-daily",
            "flow": "birdweather_ingest",
            "cron": "0 0 * * *",
            "tags": [
                "daily",
                "birdweather"
            ],
            "description": "BirdWeather local landing stage (last 24h). Fetches detections plus raw soundscapes into data/raw/birdweather so DB sync can retry independently of API collection.",
            "concurrency_limit": 1,
            "enabled": false,
            "run_on_startup": false,
            "execution_modes": [
                "cron"
            ],
            "depends_on": [],
            "parameters": {
                "hours": 24,
                "country": "Netherlands",
                "min_confidence": 0.1,
                "workers": 20,
                "target": "local",
                "download_audio": true
            }
        },
        {
            "name": "birdweather-bundle-sync",
            "flow": "birdweather_bundle_sync",
            "cron": "*/10 * * * *",
            "tags": [
                "post-processing",
                "ingestion",
                "birdweather",
                "daily"
            ],
            "description": "Sensor-owned BirdWeather bundle sync. Consumes pending local date bundles from data/raw/birdweather into TimescaleDB and MinIO, then removes successfully synced bundles.",
            "concurrency_limit": 1,
            "enabled": true,
            "run_on_startup": false,
            "execution_modes": [
                "sensor",
                "manual"
            ],
            "depends_on": [
                "birdweather-daily"
            ],
            "parameters": {
                "limit": 1,
                "delete_on_success": true,
                "output_dir": "data/raw/birdweather"
            }
        },
        {
            "name": "birdweather-repair",
            "flow": "birdweather_repair",
            "cron": "0 4 * * *",
            "tags": [
                "repair",
                "birdweather"
            ],
            "description": "Manual BirdWeather range repair for missing days and optional raw-audio recovery. Kept for ad hoc source-specific fixes; the sensor-owned birdweather-catchup handles the continuous BirdWeather backlog.",
            "concurrency_limit": 1,
            "enabled": false,
            "run_on_startup": false,
            "execution_modes": [
                "manual"
            ],
            "depends_on": [],
            "parameters": {
                "start_date": "2024-01-01",
                "end_date": "2025-12-31",
                "country": "Netherlands",
                "all_species": false,
                "min_confidence": 0.1,
                "download_audio": true,
                "workers": 20,
                "target": "database"
            }
        },
        {
            "name": "birdweather-catchup",
            "flow": "birdweather_catchup",
            "cron": "0 4 * * *",
            "tags": [
                "catchup",
                "historical",
                "birdweather"
            ],
            "description": "Sensor-owned BirdWeather historical catchup. Launches chronological multi-day windows using `followup_batch_days`, batches audio and feature follow-up work over each window, and only requests the expensive species tracker rebuild on the final catchup window.",
            "concurrency_limit": 1,
            "enabled": true,
            "run_on_startup": false,
            "execution_modes": [
                "sensor",
                "manual"
            ],
            "depends_on": [],
            "parameters": {
                "start_date": "2024-01-01",
                "end_date": "2025-12-31",
                "country": "Netherlands",
                "all_species": false,
                "min_confidence": 0.1,
                "download_audio": true,
                "followup_batch_days": 7,
                "workers": 20,
                "target": "database"
            }
        },
